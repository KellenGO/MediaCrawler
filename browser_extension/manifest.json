{
  "manifest_version": 3,
  "name": "MediaCrawler 会话同步助手",
  "version": "1.1.3",
  "description": "将当前浏览器中已登录的平台会话（小红书/抖音/B站/知乎）同步到本地 MediaCrawler 聚合搜索网站（仅 127.0.0.1:8080）。",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8080/*",
    "http://localhost:8080/*",
    "https://*.xiaohongshu.com/*",
    "https://*.douyin.com/*",
    "https://*.bilibili.com/*",
    "https://*.zhihu.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8080/*",
        "http://localhost:8080/*"
      ],
      "js": [
        "sync_protocol.js",
        "content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MediaCrawler 会话同步"
  }
}
